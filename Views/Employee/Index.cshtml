@{
    ViewData["Title"] = "Employee Portal";
}

<div class="container section">

    <div class="row justify-content-center">
        <div class="col-lg-10">

            <div class="mb-5">

                <div class="hero-eyebrow text-success">
                    EMPLOYEE PORTAL
                </div>

                <h1 class="section-heading mt-2">
                    Relief operations
                </h1>

                <p class="section-description">
                    Manage ongoing humanitarian relief activities
                    and keep the community informed.
                </p>

            </div>

            <div class="row g-4">

                <!-- Relief Projects -->
                <div class="col-md-6">

                    <div class="gotg-card h-100">

                        <div class="stat-label">
                            RELIEF MANAGEMENT
                        </div>

                        <h3 class="mt-2">
                            Relief projects
                        </h3>

                        <p class="text-muted mt-3">
                            View current relief projects, their locations,
                            descriptions and progress.
                        </p>

                        <a asp-controller="Relief"
                           asp-action="Projects"
                           class="btn btn-gotg mt-3">

                            View Relief Projects

                        </a>

                    </div>

                </div>


                <!-- Relief Updates -->
                <div class="col-md-6">

                    <div class="gotg-card h-100">

                        <div class="stat-label">
                            COMMUNITY COMMUNICATION
                        </div>

                        <h3 class="mt-2">
                            Post relief update
                        </h3>

                        <p class="text-muted mt-3">
                            Publish an update about an ongoing
                            humanitarian relief project.
                        </p>

                        <a asp-controller="Relief"
                           asp-action="CreateUpdate"
                           class="btn btn-outline-dark mt-3">

                            Post Update

                        </a>

                    </div>

                </div>

            </div>

        </div>
    </div>

</div>