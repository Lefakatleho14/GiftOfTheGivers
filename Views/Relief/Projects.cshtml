@model IEnumerable<GiftOfTheGivers.Models.ReliefProject>

@{
    ViewData["Title"] = "Relief Projects";
}

<div class="container section">

    <div class="d-flex flex-column flex-md-row
                justify-content-between
                align-items-md-end gap-3 mb-5">

        <div>

            <div class="hero-eyebrow text-success">
                RELIEF MANAGEMENT
            </div>

            <h1 class="section-heading mt-2">
                Relief projects
            </h1>

            <p class="section-description mb-0">
                Current humanitarian relief projects and their
                latest updates.
            </p>

        </div>

        <div>

            <a asp-action="CreateProject"
               class="btn btn-gotg">

                Create Project

            </a>

        </div>

    </div>


    @if (!Model.Any())
    {
        <div class="gotg-card text-center">

            <h3>
                No relief projects yet
            </h3>

            <p class="text-muted">
                Create the first relief project to begin recording
                humanitarian activities.
            </p>

            <a asp-action="CreateProject"
               class="btn btn-gotg">

                Create Relief Project

            </a>

        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var project in Model)
            {
                <div class="col-lg-6">

                    <div class="gotg-card h-100">

                        <div class="d-flex justify-content-between
                                            align-items-start gap-3">

                            <div>

                                <div class="stat-label">
                                    RELIEF PROJECT
                                </div>

                                <h3 class="mt-2">
                                    @project.Name
                                </h3>

                            </div>

                            <span class="badge bg-success">
                                @project.Status
                            </span>

                        </div>

                        <p class="mt-3 mb-2">

                            <strong>
                                Location:
                            </strong>

                            @project.Location

                        </p>

                        <p class="text-muted">
                            @project.Description
                        </p>


                        <hr />


                        <div class="stat-label">
                            LATEST UPDATES
                        </div>

                        @if (project.Updates != null &&
                                        project.Updates.Any())
                        {
                            foreach (var update in project.Updates
                            .OrderByDescending(u => u.CreatedAt)
                            .Take(3))
                            {
                                <div class="border-start border-3
                                                            ps-3 mt-3">

                                    <p class="mb-1">
                                        @update.Content
                                    </p>

                                    <small class="text-muted">
                                        @update.CreatedAt.ToLocalTime()
                                    </small>

                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted mt-3 mb-0">
                                No updates have been posted yet.
                            </p>
                        }

                    </div>

                </div>
            }

        </div>
    }

</div>