@{
    ViewData["Title"] = "About";
}

<section class="page-header">

    <div class="container">

        <span class="section-kicker">
            ABOUT THE PLATFORM
        </span>

        <h1>
            Supporting humanitarian action through technology.
        </h1>

        <p>
            A prototype relief management platform designed to connect
            donations, volunteers and relief activities.
        </p>

    </div>

</section>


<section class="section">

    <div class="container">

        <div class="row g-5 align-items-start">

            <div class="col-lg-7">

                <span class="section-kicker">
                    OUR PURPOSE
                </span>

                <h2>
                    Built around hope, dignity and practical support.
                </h2>

                <p class="lead">
                    The Gift of the Givers Relief Management System
                    demonstrates how a digital platform can support
                    humanitarian activities.
                </p>

                <p>
                    The system provides a central place where donors can
                    contribute, volunteers can register their interest
                    and authorised employees can manage relief updates.
                </p>

                <p>
                    This prototype focuses on demonstrating the feasibility
                    of these features rather than attempting to reproduce
                    a full production humanitarian management system.
                </p>

            </div>

            <div class="col-lg-5">

                <div class="info-panel">

                    <span class="section-kicker">
                        PLATFORM FEATURES
                    </span>

                    <div class="info-row">
                        <strong>01</strong>
                        <span>Donation management</span>
                    </div>

                    <div class="info-row">
                        <strong>02</strong>
                        <span>Volunteer registration</span>
                    </div>

                    <div class="info-row">
                        <strong>03</strong>
                        <span>Relief project updates</span>
                    </div>

                    <div class="info-row">
                        <strong>04</strong>
                        <span>Employee access</span>
                    </div>

                    <div class="info-row">
                        <strong>05</strong>
                        <span>Donor accounts</span>
                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<section class="section section-light">

    <div class="container">

        <div class="section-heading">

            <span class="section-kicker">
                HUMANITARIAN RESPONSE
            </span>

            <h2>
                Serving communities without losing sight of people.
            </h2>

            <p>
                Gift of the Givers describes its work around humanitarian
                assistance, disaster response and restoring hope and
                dignity to vulnerable communities.
            </p>

        </div>

    </div>

</section>