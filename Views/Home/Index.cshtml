@{
    ViewData["Title"] = "Home";
}

<!-- HERO -->
<section class="gotg-hero">
    <div class="container">
        <div class="row align-items-center min-vh-75">

            <div class="col-lg-7">

                <div class="hero-eyebrow">
                    HUMANITARIAN RELIEF
                </div>

                <h1 class="hero-title">
                    Serving humanity when help matters most.
                </h1>

                <p class="hero-text">
                    Supporting communities through humanitarian relief,
                    compassionate action and coordinated response.
                </p>

                <div class="hero-actions">

                    <a asp-controller="Donate"
                       asp-action="Index"
                       class="btn btn-gotg-primary btn-lg">
                        Make a donation
                    </a>

                    <a asp-controller="Volunteer"
                       asp-action="Index"
                       class="btn btn-gotg-outline btn-lg">
                        Volunteer
                    </a>

                </div>

            </div>

            <div class="col-lg-5 mt-5 mt-lg-0">

                <div class="hero-panel">

                    <div class="hero-panel-label">
                        OUR PURPOSE
                    </div>

                    <h2>
                        Hope. Dignity. Action.
                    </h2>

                    <p>
                        Every contribution can help provide essential
                        support to people and communities facing difficult
                        circumstances.
                    </p>

                    <div class="hero-line"></div>

                    <span>
                        For the greater good.
                    </span>

                </div>

            </div>

        </div>
    </div>
</section>


<!-- FOCUS AREAS -->
<section class="section section-light">

    <div class="container">

        <div class="section-heading">

            <span class="section-kicker">
                OUR FOCUS
            </span>

            <h2>
                Responding where support is needed.
            </h2>

            <p>
                The platform highlights the areas of humanitarian response
                supported by Gift of the Givers.
            </p>

        </div>

        <div class="row g-4">

            <div class="col-md-6 col-lg-4">
                <div class="focus-item">
                    <span class="focus-number">01</span>
                    <h3>Disaster Response</h3>
                    <p>
                        Coordinated support for communities affected by
                        disasters and emergencies.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="focus-item">
                    <span class="focus-number">02</span>
                    <h3>Hunger Alleviation</h3>
                    <p>
                        Supporting vulnerable families and communities
                        with essential food assistance.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="focus-item">
                    <span class="focus-number">03</span>
                    <h3>Water Provision</h3>
                    <p>
                        Providing access to clean and essential water
                        during times of need.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="focus-item">
                    <span class="focus-number">04</span>
                    <h3>Healthcare</h3>
                    <p>
                        Supporting healthcare initiatives for vulnerable
                        communities.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="focus-item">
                    <span class="focus-number">05</span>
                    <h3>Education</h3>
                    <p>
                        Helping create opportunities for learners and
                        communities.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="focus-item">
                    <span class="focus-number">06</span>
                    <h3>Human Development</h3>
                    <p>
                        Supporting initiatives that strengthen communities
                        and improve quality of life.
                    </p>
                </div>
            </div>

        </div>

    </div>

</section>


<!-- IMPACT -->
<section class="section gotg-impact">

    <div class="container">

        <div class="row align-items-center">

            <div class="col-lg-5">

                <span class="section-kicker section-kicker-light">
                    THE DIFFERENCE
                </span>

                <h2 class="impact-title">
                    Small actions can create meaningful change.
                </h2>

                <p class="impact-text">
                    The platform provides a simple way for donors,
                    volunteers and employees to participate in relief
                    activities.
                </p>

            </div>

            <div class="col-lg-7">

                <div class="row g-4">

                    <div class="col-sm-6">
                        <div class="impact-stat">
                            <strong>47+</strong>
                            <span>countries reached through relief efforts</span>
                        </div>
                    </div>

                    <div class="col-sm-6">
                        <div class="impact-stat">
                            <strong>120K+</strong>
                            <span>food parcels delivered per year</span>
                        </div>
                    </div>

                    <div class="col-sm-6">
                        <div class="impact-stat">
                            <strong>15K+</strong>
                            <span>patients supported monthly</span>
                        </div>
                    </div>

                    <div class="col-sm-6">
                        <div class="impact-stat">
                            <strong>3M+</strong>
                            <span>litres of water delivered monthly</span>
                        </div>
                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- CALL TO ACTION -->
<section class="section">

    <div class="container">

        <div class="gotg-cta">

            <div>
                <span class="section-kicker">
                    GET INVOLVED
                </span>

                <h2>
                    There are different ways to make a difference.
                </h2>

                <p>
                    Support relief work through a donation or register
                    your interest in volunteering.
                </p>
            </div>

            <div class="cta-actions">

                <a asp-controller="Donate"
                   asp-action="Index"
                   class="btn btn-gotg-primary">
                    Donate
                </a>

                <a asp-controller="Volunteer"
                   asp-action="Index"
                   class="btn btn-gotg-outline">
                    Volunteer
                </a>

            </div>

        </div>

    </div>

</section>