@{
    ViewData["Title"] = "Contact";
}

<section class="page-header">

    <div class="container">

        <span class="section-kicker">
            CONTACT
        </span>

        <h1>
            Get in touch.
        </h1>

        <p>
            Questions about donations, volunteering or humanitarian
            relief activities?
        </p>

    </div>

</section>


<section class="section">

    <div class="container">

        <div class="row g-5">

            <div class="col-lg-5">

                <span class="section-kicker">
                    CONTACT INFORMATION
                </span>

                <h2>
                    We're here to help.
                </h2>

                <p class="text-muted">
                    For the prototype, this section demonstrates how
                    contact information could be presented to users.
                </p>

                <div class="contact-details">

                    <div class="contact-detail">
                        <strong>National Call Centre</strong>
                        <span>0800 786 911</span>
                    </div>

                    <div class="contact-detail">
                        <strong>Email</strong>
                        <span>info@giftofthegivers.org</span>
                    </div>

                    <div class="contact-detail">
                        <strong>Head Office</strong>
                        <span>
                            290 Prince Alfred Street,
                            Pietermaritzburg, 3200
                        </span>
                    </div>

                </div>

            </div>


            <div class="col-lg-7">

                <div class="form-panel">

                    <span class="section-kicker">
                        SEND AN ENQUIRY
                    </span>

                    <h2>
                        How can we help?
                    </h2>

                    <form>

                        <div class="row g-3">

                            <div class="col-md-6">

                                <label class="form-label">
                                    Name
                                </label>

                                <input type="text"
                                       class="form-control"
                                       placeholder="Your name">

                            </div>

                            <div class="col-md-6">

                                <label class="form-label">
                                    Email
                                </label>

                                <input type="email"
                                       class="form-control"
                                       placeholder="you@example.com">

                            </div>

                            <div class="col-12">

                                <label class="form-label">
                                    Subject
                                </label>

                                <input type="text"
                                       class="form-control"
                                       placeholder="What would you like to ask?">

                            </div>

                            <div class="col-12">

                                <label class="form-label">
                                    Message
                                </label>

                                <textarea class="form-control"
                                          rows="6"
                                          placeholder="Write your message..."></textarea>

                            </div>

                            <div class="col-12">

                                <button type="button"
                                        class="btn btn-gotg-primary">
                                    Send enquiry
                                </button>

                            </div>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</section>